{
  "name": "blog",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "description": "ErBlack's blog",
  "scripts": {
    "build": "eleventy --config=eleventy.config.ts",
    "start": "eleventy --serve --config=eleventy.config.ts",
    "images": "node ./lib/scripts/images.ts",
    "post": "node ./lib/scripts/createPost.ts",
    "typecheck": "tsc",
    "fix": "prettier --log-level error --write .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ErBlack/blog.git"
  },
  "keywords": [
    "blog"
  ],
  "author": "erblack",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ErBlack/blog/issues"
  },
  "homepage": "https://erblack.me/blog/",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "@types/node": "^26.6.6",
    "eleventy-xml-plugin": "^0.1.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
