---
layout: html.liquid
styles:
    /static/post.css
---
{% assign postsKey = 'post_' | append: language.code %}{% assign languagePosts = collections[postsKey] %}{% assign nextPost = languagePosts | getNextCollectionItem: page %}{% assign previousPost = languagePosts | getPreviousCollectionItem: page %}
{% if nextPost.data.images.first %}{% prefetch_image nextPost.data.images.first %}{% endif %}{% if previousPost.data.images.first %}{% prefetch_image previousPost.data.images.first %}{% endif %}
<main class="layout">
<header class="header">
    <h1>{{title | escape}}</h1>{% if translations.size > 1 %}
    <div class="header__links">{% render "widgets/language-switch", translations: translations, language: language %}</div>{% endif %}
</header>
<section class="post">
    {% render "widgets/gallery" images: images %}
    {{content}}
</section>
<nav class="navigation">
    {% if nextPost %}<a class="navigation__link" href="{{ nextPost.url }}" id="go-left" rel="next" title="{{ nextPost.data.title | escape }}" aria-label="{{ nextPost.data.title | escape }}">{% render "icons/left.svg",  size: 32 %}</a>{% else %}<span class="navigation__link">{% render "icons/left.svg",  size: 32 %}</span>{% endif %}
    
    <a class="navigation__link" href="{{language.home}}">{% render "icons/home.svg",  size: 32 %}</a>

    {% if previousPost %}<a class="navigation__link" href="{{ previousPost.url }}" rel="prev" id="go-right" title="{{ previousPost.data.title | escape }}" aria-label="{{ previousPost.data.title | escape }}">{% render "icons/right.svg",  size: 32 %}</a>{% else %}<span class="navigation__link">{% render "icons/right.svg",  size: 32 %}</span>{% endif %}
</nav>
</main>