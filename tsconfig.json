{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "types": [
            "node"
        ],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": [
        "*.ts",
        "lib",
        "blog/**/*.ts"
    ]
}
